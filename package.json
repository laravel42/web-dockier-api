{
  "name": "dockier",
  "private": true,
  "version": "0.0.1",
  "description": "Dockier",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter frontend test:e2e",
    "test:e2e:install": "pnpm --filter frontend test:e2e:install",
    "db:migrate": "bash infra/setup-external-db.sh",
    "postinstall": "python3 pipx install semgrep || pipx install semgrep || true",
    "backend:dev": "pnpm --filter @dockier/backend-fastify dev",
    "backend:typecheck": "pnpm --filter @dockier/backend-fastify typecheck",
    "backend:start:gateway": "pnpm --filter @dockier/backend-fastify start:gateway",
    "backend:seed:admin": "pnpm --filter @dockier/backend-fastify seed:admin",
    "backend:cleanup:scans": "pnpm --filter @dockier/backend-fastify cleanup:scans",
    "docs:dev": "cd docs && pnpm dlx mint dev",
    "docs:build": "cd docs && pnpm dlx mint validate",
    "publish": "bash scripts/publish.sh",
    "publish:cloudflare": "bash scripts/publish.sh cloudflare",
    "publish:aws": "bash scripts/publish.sh aws"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.2.2",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1030.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1030.0",
    "@aws-sdk/client-codebuild": "^3.1030.0",
    "@aws-sdk/client-ec2": "^3.1038.0",
    "@aws-sdk/client-ecr": "^3.1030.0",
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/client-sns": "^3.1030.0",
    "@aws-sdk/client-ssm": "^3.1045.0",
    "@aws-sdk/client-sts": "^3.1030.0",
    "@specfy/stack-analyser": "^1.27.6",
    "adm-zip": "^0.5.17",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "otplib": "^13.4.0",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "uuid": "^13.0.0"
  }
}