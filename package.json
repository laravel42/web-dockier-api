{
  "name": "dockier",
  "private": true,
  "version": "0.0.1",
  "description": "Dockier",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "pnpm --filter frontend test:e2e",
    "lint": "pnpm backend:lint && pnpm frontend:lint",
    "lint:fix": "pnpm backend:lint:fix && pnpm frontend:lint:fix",
    "typecheck": "pnpm backend:typecheck && pnpm frontend:typecheck",
    "test:e2e:install": "pnpm --filter frontend test:e2e:install",
    "db:migrate": "bash infra/setup-external-db.sh",
    "supabase": "supabase",
    "db:link": "supabase link",
    "db:push": "bash infra/setup-external-db.sh",
    "db:reset": "supabase db reset",
    "secrets:push": "tsx scripts/cloudflare-secrets.ts push",
    "secrets:list": "tsx scripts/cloudflare-secrets.ts list",
    "secrets:store:create": "tsx scripts/cloudflare-secrets.ts store:create",
    "secrets:push:supabase": "supabase secrets set --env-file .env",
    "secrets:bridge:deploy": "pnpm exec wrangler deploy --config cloudflare/secrets-bridge/wrangler.toml",
    "postinstall": "python3 pipx install semgrep || pipx install semgrep || true",
    "backend:dev": "pnpm --filter @dockier/backend-fastify dev",
    "backend:typecheck": "pnpm --filter @dockier/backend-fastify typecheck",
    "backend:lint": "pnpm --filter @dockier/backend-fastify lint",
    "backend:lint:fix": "pnpm --filter @dockier/backend-fastify lint:fix",
    "backend:start:gateway": "pnpm --filter @dockier/backend-fastify start:gateway",
    "backend:seed:admin": "pnpm --filter @dockier/backend-fastify seed:admin",
    "backend:cleanup:scans": "pnpm --filter @dockier/backend-fastify cleanup:scans",
    "frontend:dev": "pnpm --filter frontend dev",
    "frontend:build": "pnpm --filter frontend build",
    "frontend:typecheck": "pnpm --filter frontend typecheck",
    "frontend:lint": "pnpm --filter frontend lint",
    "frontend:lint:fix": "pnpm --filter frontend lint:fix",
    "frontend:preview": "pnpm --filter frontend preview",
    "frontend:ui:add": "pnpm --filter frontend ui:add",
    "frontend:test:e2e": "pnpm --filter frontend test:e2e",
    "frontend:test:e2e:install": "pnpm --filter frontend test:e2e:install",
    "frontend:test:e2e:ui": "pnpm --filter frontend test:e2e:ui",
    "frontend:cf:pages:dev": "pnpm --filter frontend cf:pages:dev",
    "frontend:cf:pages:deploy": "pnpm --filter frontend cf:pages:deploy",
    "docs:dev": "cd docs && pnpm dlx mint dev",
    "docs:build": "cd docs && pnpm dlx mint validate",
    "publish": "bash scripts/publish.sh prod",
    "publish:prod": "bash scripts/publish.sh prod",
    "publish:railway": "bash scripts/publish.sh railway",
    "publish:cloudflare": "bash scripts/publish.sh cloudflare",
    "publish:aws": "bash scripts/publish.sh aws",
    "railway": "railway"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
  "devDependencies": {
    "@railway/cli": "^5.15.0",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "4.1.9",
    "supabase": "^2.107.0",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.102.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
