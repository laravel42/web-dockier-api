# Copy to .env on the SonarQube host. .env is gitignored; never commit it.

# Public name of this server. Its DNS A record must point here before the
# first start, or Caddy cannot obtain the certificate.
SONAR_DOMAIN=sonar.example.com

# Password for SonarQube's own Postgres. Not the app database. Generate one:
#   openssl rand -base64 32
SONARQUBE_DB_PASSWORD=
