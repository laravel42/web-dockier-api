{
  "metadata": {
    "app_id": "saas-starter-soyi"
  },
  "sql_servers": [
    {
      "host": "${DB_HOST}:${DB_PORT}",
      "tls_config": {
        "disabled": false
      },
      "databases": {
        "auth": {
          "username": "${DB_USERNAME}",
          "password": "${DB_PASSWORD}",
          "database": "auth"
        },
        "users": {
          "username": "${DB_USERNAME}",
          "password": "${DB_PASSWORD}",
          "database": "users"
        },
        "deploy": {
          "username": "${DB_USERNAME}",
          "password": "${DB_PASSWORD}",
          "database": "deploy"
        },
        "gitintegration": {
          "username": "${DB_USERNAME}",
          "password": "${DB_PASSWORD}",
          "database": "gitintegration"
        },
        "projects": {
          "username": "${DB_USERNAME}",
          "password": "${DB_PASSWORD}",
          "database": "projects"
        },
        "notifications": {
          "username": "${DB_USERNAME}",
          "password": "${DB_PASSWORD}",
          "database": "notifications"
        },
        "roles": {
          "username": "${DB_USERNAME}",
          "password": "${DB_PASSWORD}",
          "database": "roles"
        },
        "imagebuilder": {
          "username": "${DB_USERNAME}",
          "password": "${DB_PASSWORD}",
          "database": "imagebuilder"
        },
        "codeanalysis": {
          "username": "${DB_USERNAME}",
          "password": "${DB_PASSWORD}",
          "database": "codeanalysis"
        }
      }
    }
  ]
}
