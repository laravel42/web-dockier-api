# Copy to scripts/publish.env and fill in production values.
# Or export these variables in your shell before running publish.

# Public URL of the Fastify API (used to bake VITE_API_BASE into the frontend build)
DOCKIER_API_URL=https://api.example.com

# --- Cloudflare Pages ---
CF_PAGES_PROJECT=dockier-frontend
# CF_PAGES_BRANCH=main

# --- AWS ---
AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=123456789012
ECR_REPOSITORY=dockier-api
IMAGE_TAG=latest

# Optional: roll ECS after pushing the backend image
# ECS_CLUSTER=dockier
# ECS_SERVICE=dockier-api

# Frontend static hosting on AWS (set PUBLISH_FRONTEND=false to skip)
S3_FRONTEND_BUCKET=dockier-frontend
# CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC

# Backend runtime (inject via ECS task definition / secrets manager — not baked into the image)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# JWT_SECRET=
# CORS_ORIGIN=https://app.example.com
# DATABASE_URL=
# WEBHOOK_SECRET=
# OPENAI_API_KEY=
