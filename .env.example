# Copy to .env (gitignored) and fill in values.
# Production: pnpm secrets:push → Cloudflare Secrets Store.
# Optional dev overrides: .env.local (gitignored, not loaded in production).

# --- Cloudflare Secrets Store (management + production runtime) ---
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=              # Secrets Store Write (push/list only — do not push this key)
# CLOUDFLARE_SECRETS_STORE_ID=
# LOAD_SECRETS_FROM=cloudflare
# CLOUDFLARE_SECRETS_BRIDGE_URL=https://dockier-secrets-bridge.<account>.workers.dev
# CLOUDFLARE_SECRETS_BRIDGE_TOKEN=   # Worker secret (BRIDGE_TOKEN); bootstrap var on Railway
# CLOUDFLARE_SECRETS_OVERRIDE=false

# --- AWS runtime (legacy / optional fallback) ---
# LOAD_SECRETS_FROM=aws
# AWS_SECRETS_MANAGER_SECRET_ID=dockier/prod
# AWS_SSM_PARAMETER_PATH=/dockier/prod/
# AWS_REGION=us-east-1
# AWS_SECRETS_OVERRIDE=false

# --- Supabase (required) ---
# Dashboard → Settings → API Keys → Create new API keys
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy JWT key (deprecated — use SUPABASE_SECRET_KEY instead):
# SUPABASE_SERVICE_ROLE_KEY=

# Postgres (optional — pg-boss job queue)
# Direct db.*.supabase.co URLs require IPv6 on free tier. Use Supavisor pooler URLs on IPv4-only networks.
# Dashboard → Connect → Transaction pooler (app runtime, port 6543):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Dashboard → Connect → Session pooler (migrations / DDL, port 5432):
# MIGRATE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Legacy direct connection (IPv6 only on free tier):
# DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Max connections pg-boss opens. Session-mode poolers cap total clients (e.g. 15)
# shared across environments — keep this low to avoid "max clients reached"
# (EMAXCONNSESSION) errors. Default 5. Raise only if the pooler limit is also raised.
# PGBOSS_MAX_CONNECTIONS=5

# --- Backend (required) ---
NODE_ENV=development
SERVICE_NAME=gateway
PORT=4000
CORS_ORIGIN=*
JWT_SECRET=replace-with-strong-secret-at-least-16-chars

# --- Optional integrations ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# AI_DOCKERFILE_REVIEW=on            # "on" (default) or "off"; AI reviews generated Dockerfiles when an OpenAI key is set
# WEBHOOK_SECRET=
# INTERNAL_SERVICE_TOKEN=           # Separate from WEBHOOK_SECRET; used for service-to-service auth
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# SONARQUBE_URL=
# SONARQUBE_TOKEN=

# --- Admin seeder (pnpm backend:seed:admin) ---
# ADMIN_SEED_EMAIL=admin@example.com
# ADMIN_SEED_PASSWORD=
# ADMIN_SEED_DISPLAY_NAME=Dockier Admin
# ADMIN_SEED_ORG_NAME=Dockier
# ADMIN_SEED_ORG_SLUG=dockier

# --- Frontend (Vite — loaded from repo root via frontend/vite.config.ts) ---
VITE_API_BASE=http://127.0.0.1:4000

# SAST workers service (code-analysis/workers). Runs separately from the Fastify
# gateway; see code-analysis/workers/docker-compose.yml. Leave empty to fall back
# to VITE_API_BASE, which is correct when the service is exposed behind a path
# prefix on the same origin.
VITE_SAST_API_BASE=http://127.0.0.1:8100

# Shadcn Blocks registry (CLI only — not exposed to the browser)
# SHADCNBLOCKS_API_KEY=

# --- Publish / deploy (pnpm publish:prod, publish:railway, publish:cloudflare) ---
# DOCKIER_API_URL=https://dockier-api.up.railway.app
# RAILWAY_SERVICE=dockier-api
# RAILWAY_ENVIRONMENT=production
# RAILWAY_TOKEN=                   # CI deploy token
# SYNC_RAILWAY_ENV=false           # set true to push .env vars to Railway before deploy
# CF_PAGES_PROJECT=dockier-frontend
# CF_PAGES_BRANCH=main

# --- Environment Variable Encryption ---
# 32-byte key (64 hex chars) for encrypting project .env files at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))""
ENV_ENCRYPTION_KEY=
