{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-devicon-manifest.mjs && vite",
    "build": "node scripts/generate-devicon-manifest.mjs && tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ui:add": "shadcn add",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:ui": "playwright test --ui",
    "cf:pages:dev": "wrangler pages dev dist",
    "cf:pages:deploy": "wrangler pages deploy dist --project-name dockier-frontend",
    "devicons": "node scripts/generate-devicon-manifest.mjs"
  },
  "dependencies": {
    "@blocknote/core": "^0.51.4",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.0",
    "@dockier/shared-types": "workspace:*",
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/react": "^7.22.1",
    "@uiw/react-md-editor": "^4.1.0",
    "@xyflow/react": "^12.10.2",
    "ai": "^6.0.206",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.17.0",
    "prismjs": "^1.30.0",
    "radix-ui": "^1.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1",
    "react-simple-code-editor": "^0.14.1",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5",
    "eslint": "^9",
    "eslint-plugin-better-tailwindcss": "^4.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^7",
    "vitest": "^4.1.9",
    "wrangler": "^4.102.0"
  }
}
