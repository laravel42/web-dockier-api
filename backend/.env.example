NODE_ENV=development
SERVICE_NAME=gateway
PORT=4000
CORS_ORIGIN=*

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Keep service role key server-side only.
# Supabase Auth requirements for registration:
# - Enable Email provider OTP/magic-link flow.
# - Enable "Email signups" so /auth/register/start can create users.

# Auth
JWT_SECRET=replace-with-strong-secret

# Admin seeder (optional overrides)
ADMIN_SEED_EMAIL=admin@example.com
# Optional: if omitted, the seeder generates a random password (OTP/magic-link still works).
# ADMIN_SEED_PASSWORD=change-me-please
ADMIN_SEED_DISPLAY_NAME=Dockier Admin
ADMIN_SEED_ORG_NAME=Dockier
ADMIN_SEED_ORG_SLUG=dockier

# Job Queue (pg-boss) — optional, falls back to in-process execution if not set
# Use the Supabase direct connection string (not the pooler) for pg-boss
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# OpenAI (required for AI-powered project analysis sections)
OPENAI_API_KEY=sk-your-openai-api-key

# Webhook & internal service-to-service authentication
# Used to verify webhook callbacks (x-webhook-signature) and internal API calls (x-internal-token).
# In development, these endpoints are accessible without a secret. In production, this MUST be set.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WEBHOOK_SECRET=replace-with-strong-secret
