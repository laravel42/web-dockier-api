{
  "name": "@dockier/backend-fastify",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json --skipLibCheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "cleanup:scans": "tsx src/scripts/cleanup-scans.ts",
    "start:auth": "SERVICE_NAME=auth tsx src/server.ts",
    "start:users": "SERVICE_NAME=users tsx src/server.ts",
    "start:projects": "SERVICE_NAME=projects tsx src/server.ts",
    "start:gateway": "SERVICE_NAME=gateway tsx src/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1030.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1030.0",
    "@aws-sdk/client-codebuild": "^3.1030.0",
    "@aws-sdk/client-ec2": "^3.1038.0",
    "@aws-sdk/client-ecr": "^3.1030.0",
    "@aws-sdk/client-s3": "^3.1030.0",
    "@aws-sdk/client-secrets-manager": "^3.1064.0",
    "@aws-sdk/client-sns": "^3.1030.0",
    "@aws-sdk/client-ssm": "^3.1045.0",
    "@aws-sdk/client-sts": "^3.1030.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/websocket": "^11.2.0",
    "@supabase/supabase-js": "^2.58.0",
    "adm-zip": "^0.5.17",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "pg-boss": "^12.18.2",
    "pino": "10.3.1",
    "qrcode": "^1.5.4",
    "resend": "^6.12.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/adm-zip": "^0.5.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9",
    "globals": "^17.5.0",
    "tsx": "^4.22.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.2"
  }
}
